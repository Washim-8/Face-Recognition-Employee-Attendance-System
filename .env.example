# ─────────────────────────────────────────────────────────────
# Face Recognition Attendance System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false

# Database
# For Supabase on Render/cloud (requires IPv4 pooler):
# In Supabase -> Project Settings -> Database -> Connection Pooling -> URI (Session port 5432 or Transaction port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Leave blank to fall back to local SQLite (development only).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Admin credentials (used to seed the admin table on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Working-hours settings
WORK_START_TIME=09:00
LATE_THRESHOLD_MINUTES=15

# Face recognition
FACE_RECOGNITION_TOLERANCE=0.5
IMAGES_PER_EMPLOYEE=30

# Port (Render sets this automatically — leave blank locally)
# PORT=5000
