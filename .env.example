# ─────────────────────────────────────────────────────────────
# Face Recognition Attendance System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false

# Database
# For Supabase: use the "Session mode" connection string (port 5432).
# Format: postgresql://user:password@host:5432/dbname
# Leave blank to fall back to local SQLite (development only).
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Admin credentials (used to seed the admin table on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Working-hours settings
WORK_START_TIME=09:00
LATE_THRESHOLD_MINUTES=15

# Face recognition
FACE_RECOGNITION_TOLERANCE=0.5
IMAGES_PER_EMPLOYEE=30

# Port (Render sets this automatically — leave blank locally)
# PORT=5000
